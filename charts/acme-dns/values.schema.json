{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "required": ["repository", "pullPolicy", "tag"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] },
        "tag": { "type": "string" }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "existingConfigMap": { "type": "string" },
        "existingSecret": { "type": "string" },
        "general": {
          "type": "object",
          "required": ["listen", "protocol", "domain", "nsname", "nsadmin", "records", "debug"],
          "properties": {
            "listen": { "type": "string", "minLength": 1 },
            "protocol": { "enum": ["both", "both4", "both6", "udp", "udp4", "udp6", "tcp", "tcp4", "tcp6"] },
            "domain": { "type": "string", "minLength": 1 },
            "nsname": { "type": "string", "minLength": 1 },
            "nsadmin": { "type": "string", "minLength": 1 },
            "records": { "type": "array", "items": { "type": "string" } },
            "debug": { "type": "boolean" }
          }
        },
        "database": {
          "type": "object",
          "required": ["engine", "connection"],
          "properties": {
            "engine": { "enum": ["sqlite", "postgres"] },
            "connection": { "type": "string", "minLength": 1 }
          }
        },
        "api": {
          "type": "object",
          "required": ["ip", "port", "disableRegistration", "tls", "corsOrigins", "useHeader", "headerName"],
          "properties": {
            "ip": { "type": "string", "minLength": 1 },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "disableRegistration": { "type": "boolean" },
            "tls": { "enum": ["none", "cert", "letsencrypt", "letsencryptstaging"] },
            "corsOrigins": { "type": "array", "items": { "type": "string" } },
            "useHeader": { "type": "boolean" },
            "headerName": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "containerPorts": {
      "type": "object",
      "required": ["dns", "api"],
      "properties": {
        "dns": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "api": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "dns": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "externalTrafficPolicy": { "enum": ["Cluster", "Local"] }
          }
        },
        "api": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "existingClaim": { "type": "string" },
        "accessModes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "size": { "type": "string", "minLength": 1 }
      }
    },
    "livenessProbe": {
      "type": "object",
      "properties": {
        "scheme": { "enum": ["HTTP", "HTTPS"] }
      }
    },
    "readinessProbe": {
      "type": "object",
      "properties": {
        "scheme": { "enum": ["HTTP", "HTTPS"] }
      }
    }
  }
}
